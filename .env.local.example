# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Anthropic Claude API — nunca expor ao frontend
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp — número do admin para alertas (formato internacional sem +)
WHATSAPP_ADMIN_NUMBER=5511999999999

# Admin — e-mail que recebe alertas de novas análises concluídas
ADMIN_EMAIL=admin@seudominio.com.br

# Resend (e-mail transacional) — obtenha em resend.com
RESEND_API_KEY=re_...
RESEND_FROM=NextCast <noreply@seudominio.com.br>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
